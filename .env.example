# Copy to .env on the server and fill in. Never commit .env.

# Password for the web app (required). Pick something guests on your Wi-Fi can't guess.
TWY_PASSWORD=

# Your time zone, so "today" and week boundaries match your clock.
TZ=Europe/London

# Port on the server (open http://<server-ip>:8000).
TWY_PORT=8000

# User and group that own ./data on the server (`id -u`, `id -g`). deploy.sh sets these.
TWY_UID=1000
TWY_GID=1000

# Optional: fixed session key. If unset, one is generated and kept in data/secret_key.
# TWY_SECRET_KEY=
