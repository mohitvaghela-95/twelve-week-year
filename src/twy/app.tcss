/* Layout ------------------------------------------------------------------ */

.page {
    padding: 1 2;
    height: 1fr;
}

.section {
    margin-top: 1;
    text-style: bold;
    color: $accent;
}

.intro {
    margin-bottom: 1;
    color: $text-muted;
}

.muted {
    color: $text-muted;
}

.error {
    color: $error;
    height: auto;
}

.card {
    border: round $panel-lighten-2;
    padding: 0 1;
    height: auto;
}

/* Dashboard --------------------------------------------------------------- */

#banner {
    height: auto;
    padding: 0 1;
}

#banner.warn {
    background: $warning 20%;
    border-left: thick $warning;
}

#banner.info {
    background: $primary 15%;
    border-left: thick $primary;
}

#stats {
    height: auto;
}

#cycle-info {
    width: 2fr;
}

.score {
    width: 1fr;
    content-align: center middle;
    text-align: center;
}

.good { color: $success; }
.warn { color: $warning; }
.bad  { color: $error; }
.none { color: $text-muted; }

#mini-chart {
    height: 14;
    margin-top: 1;
}

#goals {
    margin-top: 1;
}

/* Plan -------------------------------------------------------------------- */

#plan-main {
    width: 2fr;
}

#plan-tree {
    height: 1fr;
    border: round $panel-lighten-2;
}

#plan-side {
    width: 1fr;
    margin-left: 1;
}

#plan-side > .card {
    margin-bottom: 1;
}

/* Review / Week 13 -------------------------------------------------------- */

#review-head {
    height: 3;
}

.inline-label {
    padding: 1 1 0 0;
}

#week {
    width: 16;
}

#week-dates {
    padding: 1 2 0 2;
    width: 1fr;
}

.score-pill {
    padding: 1 2 0 2;
    width: auto;
    text-style: bold;
}

#review-body {
    height: 1fr;
}

#rows, #lag, #w13-goals {
    height: auto;
}

.score-row {
    height: 3;
}

.tactic-title {
    width: 1fr;
    padding: 1 1 0 0;
}

.done {
    width: 12;
}

.planned {
    width: 8;
    padding: 1 0 0 1;
}

.outcome {
    width: 14;
    padding: 1 0 0 2;
}

.outcome-select {
    width: 24;
}

.note {
    height: 5;
}

TextArea.vision {
    height: 8;
}

#trend-chart {
    height: 18;
}

#trend-table {
    height: 1fr;
}

/* Modals ------------------------------------------------------------------ */

ModalScreen {
    align: center middle;
}

.dialog {
    width: 72;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

.dialog-title {
    text-style: bold;
    margin-bottom: 1;
}

.inline {
    height: auto;
}

.inline Input {
    width: 1fr;
}

.buttons {
    height: auto;
    margin-top: 1;
}

.buttons Button {
    margin-right: 2;
}
